{
  "module": "ax_sceneext",
  "target_namespace": "ax",
  "cpp_namespace": ["ax::ext", "ax::ext::timeline"],
  "macro_judgement": null,
  "headers": [
    "%(axdir)s/extensions/sceneext/src/sceneext/sceneext.h",
    "%(axdir)s/extensions/sceneext/src/sceneext/ComExtensionData.h",
    "%(axdir)s/extensions/scripting/lua-bindings/adapters/sceneext/lua-sceneext-conversions.h"
  ],
  "clang_flags": [],
  "classes": [
    "Armature",
    "ArmatureController",
    "Skin",
    "Bone",
    "ArmatureDataManager",
    "\\w+Data$",
    "ActionManagerEx",
    "ComAudio",
    "ComController",
    "ComAttribute",
    "ComRender",
    "BatchNode",
    "SceneReader",
    "GUIReader",
    "ActionObject",
    "BoneTweenController",
    "DisplayManager",
    "NodeReader",
    "ActionTimeline.*",
    ".*Frame$",
    "Timeline",
    "ActionTimelineNode",
    "ComExtensionData",
    "BoneNode",
    "SkeletonNode"
  ],
  "abstract_classes": [
    "ArmatureDataManager",
    "ComAttribute",
    "ComRender",
    "ComAudio",
    "ActionManagerEx",
    "SceneReader",
    "GUIReader",
    "BatchNode",
    "ProcessBase"
  ],
  "classes_have_no_parents": [],
  "base_classes_to_skip": [],
  "skip": [
    {
      "class": "*",
      "methods": [
        "^visit$",
        "copyWith.*",
        "onEnter.*",
        "onExit.*",
        "^description$",
        "getObjectType",
        ".*HSV",
        "onTouch.*",
        "(s|g)etUserObject",
        "add\\w*EventListener"
      ]
    },
    {
      "class": "ArmatureDataManager",
      "methods": [
        "CCArmatureDataManager",
        "~CCArmatureDataManager"
      ]
    },
    {
      "class": "Armature",
      "methods": [
        "createBone",
        "updateBlendType",
        "setBody",
        "getShapeList",
        "^getBody$"
      ]
    },
    {
      "class": "Skin",
      "methods": [
        "(s|g)etSkinData"
      ]
    },
    {
      "class": "ArmatureController",
      "methods": [
        "updateHandler",
        "updateFrameData",
        "frameEvent",
        "setMovementEventCallFunc",
        "setFrameEventCallFunc"
      ]
    },
    {
      "class": "Bone",
      "methods": [
        "getIgnoreMovementBoneData"
      ]
    },
    {
      "class": "ActionManagerEx",
      "methods": [
        "initWithDictionary",
        "initWithBinary"
      ]
    },
    {
      "class": "DisplayManager",
      "methods": [
        "initDisplayList",
        "(s|g)etCurrentDecorativeDisplay",
        "getDecorativeDisplayByIndex"
      ]
    },
    {
      "class": "BoneTweenController",
      "methods": [
        "(s|g)etMovementBoneData"
      ]
    },
    {
      "class": "GUIReader",
      "methods": [
        "registerTypeAndCallBack",
        "storeFileDesignSize",
        "getFileDesignSize",
        "getParseCallBackMap",
        "getParseObjectMap"
      ]
    },
    {
      "class": "ActionNode",
      "methods": [
        "initWithDictionary"
      ]
    },
    {
      "class": "ActionObject",
      "methods": [
        "initWithDictionary",
        "initWithBinary"
      ]
    },
    {
      "class": "BaseData",
      "methods": [
        "copy",
        "subtract"
      ]
    },
    {
      "class": "ActionTimelineCache",
      "methods": [
        "getInstance",
        "loadActionTimelineFromXML",
        "loadAnimationWithDataBuffer",
        "createActionWithDataBuffer"
      ]
    },
    {
      "class": "ActionTimeline",
      "methods": [
        "setFrameEventCallFunc"
      ]
    }
  ],
  "rename_functions": [
    {
      "class": "ActionManagerEx",
      "method": "^shareManager$",
      "luaName": "getInstance"
    },
    {
      "class": "ActionManagerEx",
      "method": "^purgeActionManager$",
      "luaName": "destroyInstance"
    },
    {
      "class": "SceneReader",
      "method": "^purgeSceneReader$",
      "luaName": "destroyInstance"
    },
    {
      "class": "ComAudio",
      "method": "^end$",
      "luaName": "endToLua"
    }
  ],
  "rename_classes": []
}
