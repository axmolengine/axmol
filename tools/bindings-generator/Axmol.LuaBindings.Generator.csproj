<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Keep the production generator compatible with PowerShell 7.4/.NET 8.
         A local ClangSharp checkout is an explicit development override and
         must itself be net8-compatible. -->
    <GeneratorTargetFramework>net8.0</GeneratorTargetFramework>
    <TargetFramework>$(GeneratorTargetFramework)</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <ClangSharpInteropVersion>21.1.8.3</ClangSharpInteropVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src/**/*.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(ClangSharpRoot)' == ''">
    <!-- PackageDownload fetches only this managed interop assembly.  A normal
         PackageReference would pull libClangSharp/libclang transitively;
         Axmol deliberately supplies libclang through 1kiss instead. -->
    <PackageDownload Include="ClangSharp.Interop" Version="[$(ClangSharpInteropVersion)]" />
    <Reference Include="ClangSharp.Interop">
      <HintPath>$(NuGetPackageRoot)\clangsharp.interop\$(ClangSharpInteropVersion)\lib\net8.0\ClangSharp.Interop.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(ClangSharpRoot)' != ''">
    <Compile Include="$(ClangSharpRoot)/sources/ClangSharp.Interop/**/*.cs" />
  </ItemGroup>

</Project>
